# AI Code Review Assistant - Environment Variables
PROJECT_NAME="AI Code Review Assistant"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in Docker / SQLite locally)
DATABASE_URL="sqlite:///./code_review.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/code_review"

# Security & JWT Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI / LLM Provider Configuration
# Options: "smart_fallback" (Zero-API-key local offline reasoning), "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER="smart_fallback"
LLM_API_KEY=""
LLM_MODEL="gpt-4o"
LLM_BASE_URL=""
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45

# Review Pipeline Thresholds
MIN_CONFIDENCE=0.60
MAX_FILE_SIZE_KB=2048
RATE_LIMIT_PER_MINUTE=60

# GitHub Integration
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Frontend API URL (for Vite)
VITE_API_URL="http://localhost:8000/api/v1"
